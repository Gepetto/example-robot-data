      </joint>
    </transmission>
    <transmission name="leg_${side}_${roll_joint}_transmission">
      <type>transmission_interface/SimpleTransmission</type>
      <actuator name="leg_${side}_${roll_joint}_motor" >
        <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
        <hardwareInterface>hardware_interface/JointStateInterface</hardwareInterface>
        <mechanicalReduction>1.0</mechanicalReduction>
      </actuator>
      <joint name="leg_${side}_${roll_joint}_joint">
        <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
        <hardwareInterface>hardware_interface/JointStateInterface</hardwareInterface>
      </joint>
    </transmission> -->
  <transmission name="leg_left_transmission">
    <type>kangaroo_transmissions/AnkleCustomTransmission</type>
    <actuator name="leg_left_5_motor">
      <role>right_actuator</role>
      <param_ns>/ankle_params</param_ns>
    </actuator>
    <actuator name="leg_left_4_motor">
      <role>left_actuator</role>
    </actuator>
    <actuator name="leg_left_length_motor">
      <role>leg_length</role>
      <param_ns>/leg_params</param_ns>
    </actuator>
    <joint name="leg_left_5_joint">
      <role>roll_joint</role>
      <offset> 0.0 </offset>
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    </joint>
    <joint name="leg_left_4_joint">
      <role>pitch_joint</role>
      <offset> 0.0 </offset>
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    </joint>
  </transmission>
  <gazebo reference="leg_left_4_joint">
    <implicitSpringDamper>1</implicitSpringDamper>
  </gazebo>
  <gazebo reference="leg_left_5_joint">
    <implicitSpringDamper>1</implicitSpringDamper>
    <provideFeedback>1</provideFeedback>
  </gazebo>
  <gazebo reference="leg_left_4_link">
    <mu1>0.9</mu1>
    <mu2>0.9</mu2>
    <implicitSpringDamper>1</implicitSpringDamper>
    <material>Gazebo/FlatWhite</material>
  </gazebo>
  <!--
   <gazebo reference="leg_${side}_${roll_joint}_link">
     <mu1>0.9</mu1>
     <mu2>0.9</mu2>
     <implicitSpringDamper>1</implicitSpringDamper>
     <material>Gazebo/FlatWhite</material>
   </gazebo>  -->
  <gazebo reference="leg_left_5_link">
    <kp>1000000.0</kp>
    <!-- 1000000 -->
    <kd>100.0</kd>
    <mu1>10.0</mu1>
