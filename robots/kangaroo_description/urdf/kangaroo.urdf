  <transmission name="leg_left_yaw_transmission">
    <type>kangaroo_transmissions/HipZCustomTransmission</type>
    <actuator name="leg_left_1_motor">
      </actuator>
    <joint name="leg_left_1_joint">
      <side> left </side>
      <param_ns> /left_hip_z_2023_params </param_ns>
      <offset> 0.0 </offset>
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      <hardwareInterface>hardware_interface/JointStateInterface</hardwareInterface>
    </joint>
  </transmission>
  <transmission name="leg_left_hip_transmission">
    <type>kangaroo_transmissions/HipCustomTransmission</type>
    <actuator name="leg_left_3_motor">
      <role>actuator1</role>
      <virtual_linear_actuator>
        <screw_lead> 0.005 </screw_lead>
        <efficiency> 0.9 </efficiency>
        <limits>
          <position>
            <min> 0.0 </min>
            <max> 0.10 </max>
          </position>
          <velocity>
            <min> -0.3 </min>
            <max> 0.3 </max>
          </velocity>
        </limits>
      </virtual_linear_actuator>
      <mechanicalReduction>1.0</mechanicalReduction>
    </actuator>
    <actuator name="leg_left_2_motor">
      <role>actuator2</role>
      <virtual_linear_actuator>
        <screw_lead> 0.005 </screw_lead>
        <efficiency> 0.9 </efficiency>
        <limits>
          <position>
            <min> 0.0 </min>
            <max> 0.10 </max>
          </position>
          <velocity>
            <min> -0.3 </min>
            <max> 0.3 </max>
          </velocity>
        </limits>
      </virtual_linear_actuator>
      <mechanicalReduction>1.0</mechanicalReduction>
    </actuator>
    <joint name="leg_left_3_joint">
      <role>joint1</role>
      <limits>
        <position>
          <min> -0.47123889803846897 </min>
          <max> 0.47123889803846897 </max>
        </position>
      </limits>
      <configuration>
        <offset_x> 0.035 </offset_x>
        <offset_y> 0.0475 </offset_y>
        <projected_distance> 0.10412 </projected_distance>
        <dx> 0.035 </dx>
        <dy> 0.060 </dy>
      </configuration>
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    </joint>
    <joint name="leg_left_2_joint">
      <role>joint2</role>
      <limits>
        <position>
          <min> -0.7417649320975901 </min>
          <max> 0.7417649320975901 </max>
        </position>
      </limits>
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    </joint>
  </transmission>
  <transmission name="leg_left_knee_transmission">
    <type>transmission_interface/SimpleTransmission</type>
    <actuator name="leg_left_femur_motor">
      <mechanicalReduction>1.0</mechanicalReduction>
    </actuator>
    <joint name="leg_left_femur_joint">
      <offset> 0.0 </offset>
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    </joint>
  </transmission>
