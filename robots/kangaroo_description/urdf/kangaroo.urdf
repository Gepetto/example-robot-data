  <transmission name="leg_right_transmission">
    <type>kangaroo_transmissions/AnkleCustomTransmission</type>
    <actuator name="leg_right_5_motor">
      <role>right_actuator</role>
      <param_ns>/ankle_params</param_ns>
    </actuator>
    <actuator name="leg_right_4_motor">
      <role>left_actuator</role>
    </actuator>
    <actuator name="leg_right_length_motor">
      <role>leg_length</role>
      <param_ns>/leg_params</param_ns>
    </actuator>
    <joint name="leg_right_5_joint">
      <role>roll_joint</role>
      <offset> 0.0 </offset>
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    </joint>
    <joint name="leg_right_4_joint">
      <role>pitch_joint</role>
      <offset> 0.0 </offset>
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    </joint>
  </transmission>
  <gazebo reference="leg_right_4_joint">
    <implicitSpringDamper>1</implicitSpringDamper>
  </gazebo>
  <gazebo reference="leg_right_5_joint">
    <implicitSpringDamper>1</implicitSpringDamper>
    <provideFeedback>1</provideFeedback>
  </gazebo>
  <gazebo reference="leg_right_4_link">
    <mu1>0.9</mu1>
    <mu2>0.9</mu2>
    <implicitSpringDamper>1</implicitSpringDamper>
    <material>Gazebo/FlatWhite</material>
  </gazebo>
