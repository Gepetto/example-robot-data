<?xml version="1.0" encoding="UTF-8"?>
<!-- Semantic description for b1.urdf.xacro closed_loop:=true.

     The URDF is a tree with a split coupler. Each loop_constraint joins the
     split end frames in x, z and pitch, leaving the physical planar four-bar
     with three independent coordinates per leg. -->
<robot name="b1">
    <group name="imu">
        <link name="imu_link"/>
    </group>

    <group name="FL_foot">
        <joint name="FL_hip_joint"/>
        <joint name="FL_thigh_joint"/>
        <joint name="FL_calf_joint"/>
        <joint name="FL_crank_bar2_thigh"/>
        <joint name="FL_link_1_crank_bar1"/>
        <joint name="FL_link_2_crank_bar2"/>
    </group>
    <group name="FR_foot">
        <joint name="FR_hip_joint"/>
        <joint name="FR_thigh_joint"/>
        <joint name="FR_calf_joint"/>
        <joint name="FR_crank_bar2_thigh"/>
        <joint name="FR_link_1_crank_bar1"/>
        <joint name="FR_link_2_crank_bar2"/>
    </group>
    <group name="RL_foot">
        <joint name="RL_hip_joint"/>
        <joint name="RL_thigh_joint"/>
        <joint name="RL_calf_joint"/>
        <joint name="RL_crank_bar2_thigh"/>
        <joint name="RL_link_1_crank_bar1"/>
        <joint name="RL_link_2_crank_bar2"/>
    </group>
    <group name="RR_foot">
        <joint name="RR_hip_joint"/>
        <joint name="RR_thigh_joint"/>
        <joint name="RR_calf_joint"/>
        <joint name="RR_crank_bar2_thigh"/>
        <joint name="RR_link_1_crank_bar1"/>
        <joint name="RR_link_2_crank_bar2"/>
    </group>

    <group name="lf_leg">
        <group name="FL_foot"/>
    </group>
    <group name="rf_leg">
        <group name="FR_foot"/>
    </group>
    <group name="lh_leg">
        <group name="RL_foot"/>
    </group>
    <group name="rh_leg">
        <group name="RR_foot"/>
    </group>
    <group name="all_legs">
        <group name="lf_leg"/>
        <group name="rf_leg"/>
        <group name="lh_leg"/>
        <group name="rh_leg"/>
    </group>
    <group name="r_legs">
        <group name="rf_leg"/>
        <group name="rh_leg"/>
    </group>
    <group name="l_legs">
        <group name="lf_leg"/>
        <group name="lh_leg"/>
    </group>
    <group name="f_legs">
        <group name="lf_leg"/>
        <group name="rf_leg"/>
    </group>
    <group name="h_legs">
        <group name="lh_leg"/>
        <group name="rh_leg"/>
    </group>
    <group name="ld_legs">
        <group name="lf_leg"/>
        <group name="rh_leg"/>
    </group>
    <group name="rd_legs">
        <group name="rf_leg"/>
        <group name="lh_leg"/>
    </group>
    <group name="whole_body">
        <joint name="root_joint"/>
        <group name="all_legs"/>
    </group>

    <loop_constraint frame1="FL_closedloop3D_1B" frame2="FL_closedloop3D_1A" mask="x z pitch"/>
    <loop_constraint frame1="FR_closedloop3D_1B" frame2="FR_closedloop3D_1A" mask="x z pitch"/>
    <loop_constraint frame1="RL_closedloop3D_1B" frame2="RL_closedloop3D_1A" mask="x z pitch"/>
    <loop_constraint frame1="RR_closedloop3D_1B" frame2="RR_closedloop3D_1A" mask="x z pitch"/>

    <!-- Crossed assembly branch at the same public standing pose as the
         serial model. The dependent coordinates solve all 12 loop equations. -->
    <group_state name="standing" group="whole_body">
        <joint name="FL_hip_joint" value="0.0"/>
        <joint name="FL_thigh_joint" value="0.642"/>
        <joint name="FL_calf_joint" value="-1.259"/>
        <joint name="FL_crank_bar2_thigh" value="1.4263535223746131"/>
        <joint name="FL_link_1_crank_bar1" value="1.5371579780513211"/>
        <joint name="FL_link_2_crank_bar2" value="1.9933971092665013"/>

        <joint name="FR_hip_joint" value="0.0"/>
        <joint name="FR_thigh_joint" value="0.642"/>
        <joint name="FR_calf_joint" value="-1.259"/>
        <joint name="FR_crank_bar2_thigh" value="1.4263535223746131"/>
        <joint name="FR_link_1_crank_bar1" value="1.5371579780513211"/>
        <joint name="FR_link_2_crank_bar2" value="1.9933971092665013"/>

        <joint name="RL_hip_joint" value="0.0"/>
        <joint name="RL_thigh_joint" value="0.642"/>
        <joint name="RL_calf_joint" value="-1.259"/>
        <joint name="RL_crank_bar2_thigh" value="1.4263535223746131"/>
        <joint name="RL_link_1_crank_bar1" value="1.5371579780513211"/>
        <joint name="RL_link_2_crank_bar2" value="1.9933971092665013"/>

        <joint name="RR_hip_joint" value="0.0"/>
        <joint name="RR_thigh_joint" value="0.642"/>
        <joint name="RR_calf_joint" value="-1.259"/>
        <joint name="RR_crank_bar2_thigh" value="1.4263535223746131"/>
        <joint name="RR_link_1_crank_bar1" value="1.5371579780513211"/>
        <joint name="RR_link_2_crank_bar2" value="1.9933971092665013"/>
    </group_state>

    <end_effector name="lf_foot" parent_link="FL_foot" group="lf_leg"/>
    <end_effector name="rf_foot" parent_link="FR_foot" group="rf_leg"/>
    <end_effector name="lh_foot" parent_link="RL_foot" group="lh_leg"/>
    <end_effector name="rh_foot" parent_link="RR_foot" group="rh_leg"/>
    <virtual_joint name="root_joint" type="floating" parent_frame="world_frame" child_link="base"/>
</robot>
